{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "atlas/lesson.schema.json",
  "title": "Atlas lesson (rack/course/lessons/<id>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "num", "part", "title", "goal", "builds", "minutes", "blocks", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^p\\d-\\d\\d-[a-z0-9-]+$" },
    "num": { "type": "string", "pattern": "^\\d\\.\\d$" },
    "part": { "type": "integer", "minimum": 0, "maximum": 9 },
    "title": { "type": "string", "minLength": 2 },
    "goal": { "type": "string", "minLength": 10 },
    "builds": { "type": "string", "minLength": 5 },
    "minutes": { "type": "integer", "minimum": 5, "maximum": 120 },
    "requires": { "type": "array", "items": { "type": "string" } },
    "glossary": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "blocks": { "type": "array", "minItems": 3, "items": { "$ref": "#/definitions/block" } }
  },
  "definitions": {
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q", "a"],
        "properties": { "q": { "type": "string" }, "a": { "type": "string" } }
      }
    },
    "figure": {
      "type": "object",
      "required": ["template"],
      "properties": { "template": { "type": "string" }, "caption": { "type": "string" } }
    },
    "paramValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "display": { "type": ["string", "number"] }, "raw": { "type": "number" } }
        }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "plugin", "slug"],
      "properties": {
        "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "plugin": { "type": "string" },
        "slug": { "type": "string" },
        "params": { "type": "object", "additionalProperties": { "$ref": "#/definitions/paramValue" } },
        "data": { "type": "object" }
      }
    },
    "endpoint": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
    "cable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/definitions/endpoint" }, "to": { "$ref": "#/definitions/endpoint" } }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module"],
      "properties": {
        "module": { "type": "string" },
        "param": { "type": "string" },
        "input": { "type": "string" },
        "output": { "type": "string" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "after": { "type": "string" },
        "text": { "type": "string" },
        "targets": { "type": "array", "items": { "$ref": "#/definitions/target" } }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "why"],
      "properties": { "text": { "type": "string" }, "correct": { "type": "boolean" }, "why": { "type": "string" } }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "options"],
      "properties": {
        "q": { "type": "string" },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/definitions/option" } },
        "free": { "type": "boolean" }
      }
    },
    "hints": {
      "type": "object",
      "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
    },
    "block": {
      "type": "object",
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^b\\d+$" },
        "type": { "enum": ["cover", "story", "live", "anatomy", "try", "quiz", "practice", "debug", "recap"] },
        "preset": { "enum": ["cover", "story", "live", "anatomy", "try", "quiz", "practice", "debug", "recap"] },
        "title": { "type": "string" },
        "page": { "type": "string" },
        "page2": { "type": "string" },
        "lead": { "type": "string" },
        "next": { "type": "string" },
        "simpler": { "type": "string" },
        "figure": { "$ref": "#/definitions/figure" },
        "faq": { "$ref": "#/definitions/faq" },
        "modules": { "type": "array", "items": { "$ref": "#/definitions/module" } },
        "module": { "$ref": "#/definitions/module" },
        "cables": { "type": "array", "items": { "$ref": "#/definitions/cable" } },
        "notes": { "type": "array", "items": { "$ref": "#/definitions/note" } },
        "later": {
          "type": "array",
          "items": { "type": "object", "properties": { "what": { "type": "string" }, "lesson": { "type": "string" } } }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["do"],
            "properties": { "do": { "type": "string" }, "see": { "type": "string" } }
          }
        },
        "questions": { "type": "array", "items": { "$ref": "#/definitions/question" } },
        "task": { "type": "string" },
        "given": { "type": "array", "items": { "type": "string" } },
        "check": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "const": "fixed" },
                "expect_cable": { "type": "array" },
                "expect_param": {}
              }
            }
          ]
        },
        "break": {
          "type": "object",
          "properties": {
            "remove_cable": { "type": "array", "items": { "type": "string" }, "minItems": 4, "maxItems": 4 },
            "set_param": { "type": "object" }
          }
        },
        "hints": { "$ref": "#/definitions/hints" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "cover" } } }, "then": { "required": ["page", "faq"] } },
        { "if": { "properties": { "type": { "const": "story" } } }, "then": { "required": ["page", "faq"] } },
        { "if": { "properties": { "type": { "const": "live" } } }, "then": { "required": ["page", "modules", "faq"] } },
        { "if": { "properties": { "type": { "const": "anatomy" } } }, "then": { "required": ["page", "module", "notes", "faq"] } },
        { "if": { "properties": { "type": { "const": "try" } } }, "then": { "required": ["steps", "modules", "faq"] } },
        { "if": { "properties": { "type": { "const": "quiz" } } }, "then": { "required": ["questions"] } },
        { "if": { "properties": { "type": { "const": "practice" } } }, "then": { "required": ["task", "check", "hints", "faq"] } },
        { "if": { "properties": { "type": { "const": "debug" } } }, "then": { "required": ["task", "modules", "break", "check", "hints", "faq"] } },
        { "if": { "properties": { "type": { "const": "recap" } } }, "then": { "required": ["page", "next", "faq"] } }
      ]
    }
  }
}
